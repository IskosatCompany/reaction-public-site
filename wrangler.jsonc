// Worker só com ficheiros estáticos: o `wrangler deploy` publica o `dist` gerado pelo `npm run build`.
// Sem este ficheiro, o wrangler reconfigura o projeto (instala o @cloudflare/vite-plugin, que parte o
// build SSR) e trata o site como SPA.
{
  "name": "reaction",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    // Devolve o 404.html com estado 404 em vez da homepage.
    "not_found_handling": "404-page"
  }
}
